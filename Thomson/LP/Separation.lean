/-- **Sharp separation.**  Every admissible eight-point configuration whose energy is at most
that of the best square antiprism has all `28` pairwise distances greater than `0.962`.

Compare `separated_of_near_optimal` (§14), which gives only `1/19.6753 > 0.0508`: the slack
form of the Yudin bound improves the separation constant by a factor of nineteen.  For scale,
the conjectured minimiser's own shortest distance is `1.1713`, and the largest separation any
eight points can achieve (the Tammes value) is `1.2157`. -/
theorem separation_of_energy_le {x : Fin 8 → EuclideanSpace ℝ (Fin 3)} (hx : Admissible x)
    (hE : energy x ≤ 19.6753) {i j : Fin 8} (hij : i ≠ j) : 481/500 < ‖x i - x j‖ := by
  by_contra hcon
  push_neg at hcon
  have hne : x i - x j ≠ 0 := sub_ne_zero.mpr (fun h => hij (hx.2 h))
  have hpos : 0 < ‖x i - x j‖ := norm_pos_iff.mpr hne
  have hslack := yudin12_pair_slack hx hij
  have hinner : (⟪x i, x j⟫ : ℝ) = 1 - ‖x i - x j‖ ^ 2 / 2 :=
    inner_eq_of_norm _ _ (hx.1 i) (hx.1 j)
  rw [hinner] at hslack
  have hcert := yudin12_slack_gt hpos hcon
  have hdiv : (277361 / 10000000 : ℝ)
      < ‖x i - x j‖⁻¹ - yudinF12 (1 - ‖x i - x j‖ ^ 2 / 2) := by
    rw [← sub_pos] at hcert ⊢
    have hre : ‖x i - x j‖⁻¹ - yudinF12 (1 - ‖x i - x j‖ ^ 2 / 2) - 277361 / 10000000
        = (1 - ‖x i - x j‖ * yudinF12 (1 - ‖x i - x j‖ ^ 2 / 2)
            - 277361 / 10000000 * ‖x i - x j‖) / ‖x i - x j‖ := by
      field_simp
    rw [hre]
    exact div_pos hcert hpos
  norm_num at hE hslack hdiv
  linarith

/-- The sharp separation, in the `Separated` language of §1. -/
theorem separated_sharp {x : Fin 8 → EuclideanSpace ℝ (Fin 3)} (hx : Admissible x)
    (hE : energy x ≤ 19.6753) : Separated (481/500) x :=
  fun _ _ hij => (separation_of_energy_le hx hE hij).le



end Thomson
