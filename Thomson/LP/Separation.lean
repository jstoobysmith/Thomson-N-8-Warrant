/-! ## 15. Slack rigidity: what a configuration that beats the antiprism must look like

The degree-12 Yudin argument of §13 compares `‖xᵢ-xⱼ‖⁻¹` with `f(⟪xᵢ,xⱼ⟫)` pair by pair and
then discards the comparison.  Keeping it turns the bound into an *exact* decomposition

`E(x) = B₁₂ + ∑_{i<j} (‖xᵢ-xⱼ‖⁻¹ - f(⟪xᵢ,xⱼ⟫)) + ½ ∑ₖ cₖ ∑_{i,j} Pₖ(⟪xᵢ,xⱼ⟫)`,

in which both sums are nonnegative — the first because `f(1-s²/2) ≤ 1/s` (`yudinF12_le_inv`),
the second by Schoenberg positivity (`sum_P12_nonneg` and friends).  A configuration with
`E(x) ≤ 19.6753` therefore has a *budget* of `19.6753 - B₁₂ < 0.0277361` to spend on the whole
of the first sum, so every single pair must stay inside that budget.  Since the slack
`1/s - f(1-s²/2)` blows up as `s → 0`, this is a strong separation statement.

This is the one place where the linear-programming method gives more than its optimal value:
the *value* is capped at `19.6478` (§13), but the *slack* still carries information.  It is
what replaces the crude bound `1/E ≈ 0.0508` of §14 by `0.962`, a factor of nineteen. -/

/-- The degree-12 Yudin bound, kept in slack form: for any single pair, the amount by which the
Coulomb term exceeds the Yudin polynomial is at most `E(x) - B₁₂`. -/
theorem yudin12_pair_slack {x : Fin 8 → EuclideanSpace ℝ (Fin 3)} (hx : Admissible x)
    {a b : Fin 8} (hab : a ≠ b) :
    ‖x a - x b‖⁻¹ - yudinF12 ⟪x a, x b⟫ ≤ energy x - 196475639 / 10000000 := by
  obtain ⟨hsph, hinj⟩ := hx
  set G : Fin 8 → Fin 8 → ℝ := fun i j => ‖x i - x j‖⁻¹ - yudinF12 ⟪x i, x j⟫ with hG
  have hGnn : ∀ i j : Fin 8, i ≠ j → 0 ≤ G i j := by
    intro i j hij
    have hne : x i - x j ≠ 0 := sub_ne_zero.mpr (fun h => hij (hinj h))
    have hpos : 0 < ‖x i - x j‖ := norm_pos_iff.mpr hne
    have hle2 : ‖x i - x j‖ ≤ 2 := by
      have h := norm_sub_le (x i) (x j)
      rw [hsph i, hsph j] at h; linarith
    have hkey := yudinF12_le_inv hpos hle2
    have hinner : (⟪x i, x j⟫ : ℝ) = 1 - ‖x i - x j‖ ^ 2 / 2 :=
      inner_eq_of_norm _ _ (hsph i) (hsph j)
    simp only [hG, hinner]
    linarith
  -- every row of the slack matrix is nonnegative
  have hrow : ∀ i : Fin 8, 0 ≤ ∑ j ∈ univ.erase i, G i j := fun i =>
    Finset.sum_nonneg fun j hj => hGnn i j (Finset.ne_of_mem_erase hj).symm
  -- the two ordered copies of the pair `(a,b)` are dominated by the whole double sum
  have hrowa : G a b ≤ ∑ j ∈ univ.erase a, G a j := by
    have hsub : ({b} : Finset (Fin 8)) ⊆ univ.erase a := by
      simp [Finset.subset_iff, Finset.mem_erase, hab.symm]
    have h := Finset.sum_le_sum_of_subset_of_nonneg hsub
      (fun j hj _ => hGnn a j (Finset.ne_of_mem_erase hj).symm)
    simpa using h
  have hrowb : G b a ≤ ∑ j ∈ univ.erase b, G b j := by
    have hsub : ({a} : Finset (Fin 8)) ⊆ univ.erase b := by
      simp [Finset.subset_iff, Finset.mem_erase, hab]
    have h := Finset.sum_le_sum_of_subset_of_nonneg hsub
      (fun j hj _ => hGnn b j (Finset.ne_of_mem_erase hj).symm)
    simpa using h
  have hsymm : G b a = G a b := by
    simp only [hG, norm_sub_rev (x b) (x a), real_inner_comm (x b) (x a)]
  have hpair : 2 * G a b ≤ ∑ i, ∑ j ∈ univ.erase i, G i j := by
    have h := Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.subset_univ ({a, b} : Finset (Fin 8))) (fun i _ _ => hrow i)
    rw [Finset.sum_pair hab] at h
    have := hrowa; have := hrowb; rw [hsymm] at hrowb
    linarith
  -- the double sum of slacks is `2E` minus the double sum of the Yudin polynomial
  have hsum : ∑ i, ∑ j ∈ univ.erase i, G i j
      = 2 * energy x - ∑ i, ∑ j ∈ univ.erase i, yudinF12 ⟪x i, x j⟫ := by
    simp only [hG, Finset.sum_sub_distrib]
    rw [energy_eq_half]; ring
  -- Schoenberg positivity bounds the double sum of the Yudin polynomial below by `2B₁₂`
  have hoff : 2 * (196475639 / 10000000 : ℝ)
      ≤ ∑ i, ∑ j ∈ univ.erase i, yudinF12 ⟪x i, x j⟫ := by
    have hdiag : ∀ i : Fin 8, yudinF12 ⟪x i, x i⟫ = yudinF12 1 := by
      intro i; rw [real_inner_self_eq_norm_sq, hsph i]; norm_num
    have hsplit : ∑ i, ∑ j, yudinF12 ⟪x i, x j⟫
        = ∑ i, yudinF12 ⟪x i, x i⟫ + ∑ i, ∑ j ∈ univ.erase i, yudinF12 ⟪x i, x j⟫ := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
    have hlower : (64 : ℝ) * (25112058114515892702458371168699918546758419316915880412639437758263139355711703125/31240132497277551739207802466097741324814744614907020357455122977304711645720637288) ≤ ∑ i, ∑ j, yudinF12 ⟪x i, x j⟫ := by
      simp only [yudinF12_legendre, Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      have h1 := sum_P1_nonneg x
      have h2 := sum_P2_nonneg x hsph
      have h3 := sum_P3_nonneg x hsph
      have h4 := sum_P4_nonneg x hsph
      have h7 := sum_P7_nonneg x hsph
      have h12 := sum_P12_nonneg x hsph
      push_cast
      linarith
    have hf1 : yudinF12 1 = 13758168730630577439177979321639367763328957522925277625489850892359375/9058420591342176993351704978531960850644159086157308834471768161780132 := by
      unfold yudinF12; norm_num
    rw [hsplit] at hlower
    simp only [hdiag, hf1, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul] at hlower
    push_cast at hlower
    norm_num at hlower ⊢
    linarith
  linarith [hpair, hsum, hoff]

