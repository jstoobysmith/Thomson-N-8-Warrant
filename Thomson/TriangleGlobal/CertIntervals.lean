/-! ### The slot indicators and the assembled `H` -/

/-- `Thomson.slot`, as a match on `ℕ`: see `pivQn`. -/
def slotN : ℕ → ℕ × ℕ × ℕ
  | 0 => (0, 0, 2)
  | 1 => (0, 0, 6)
  | 2 => (0, 0, 7)
  | 3 => (0, 1, 3)
  | 4 => (0, 2, 4)
  | 5 => (0, 3, 6)
  | 6 => (0, 5, 7)
  | 7 => (1, 0, 0)
  | 8 => (1, 0, 1)
  | 9 => (1, 0, 2)
  | 10 => (1, 2, 3)
  | 11 => (2, 0, 0)
  | 12 => (2, 0, 1)
  | 13 => (2, 1, 2)
  | 14 => (2, 3, 5)
  | 15 => (3, 0, 0)
  | 16 => (3, 0, 1)
  | 17 => (3, 0, 3)
  | 18 => (3, 1, 2)
  | 19 => (4, 0, 0)
  | 20 => (4, 0, 1)
  | 21 => (4, 0, 2)
  | 22 => (5, 0, 0)
  | 23 => (5, 0, 1)
  | _ => (9, 9, 9)

@[simp] theorem slotN_eq (j : Fin 24) : slotN (j : ℕ) = slot j := by fin_cases j <;> rfl

def eHI (j : Fin 24) (k a b : ℕ) : Itv :=
  if slotN (j : ℕ) = (k, a, b) ∨ slotN (j : ℕ) = (k, b, a) then Itv.cst SCALE else Itv.zero

theorem ITMem_eHI (j : Fin 24) (k a b : ℕ) : (eHI j k a b).Mem (eH j k a b) := by
  simp only [eHI, eH, slotN_eq]
  split_ifs
  · exact Itv.mem_one
  · exact Itv.mem_zero

/-- `Hp pivotsNum` on the grid. -/
def HI (k a b : ℕ) : Itv :=
  Itv.add (HfixI k a b)
    (Itv.sumL ((List.finRange 24).map (fun j : Fin 24 => Itv.mul (eHI j k a b) (pivI j))))

theorem ITMem_HI (k : Fin 6) (a b : Fin (9 - (k : ℕ))) :
    (HI (k : ℕ) (a : ℕ) (b : ℕ)).Mem (Hp pivotsNum k a b) := by
  have hk : (k : ℕ) < 6 := k.isLt
  have ha : (a : ℕ) < 9 := by have := a.isLt; omega
  have hb : (b : ℕ) < 9 := by have := b.isLt; omega
  unfold Hp
  simp only [Matrix.of_apply]
  refine Itv.mem_add (ITMem_HfixI _ _ _ hk ha hb) ?_
  exact Itv.mem_sum_fin _ _ fun j => Itv.mem_mul (ITMem_eHI j _ _ _) (ITMem_pivI j)

/-! ### The constant matrices -/

/-- `M_k = B_k (Hp pivotsNum)_k B_kᵀ`, as interval data. -/
def MIdata : (k : Fin 6) → Fin (9 - (k : ℕ)) → Fin (9 - (k : ℕ)) → Itv := MI BI HI

theorem ITMem_MIdata (k : Fin 6) (i j : Fin (9 - (k : ℕ))) :
    (MIdata k i j).Mem (Mmat (Hp pivotsNum) k i j) := by
  refine ITMem_MI (fun k i a => ?_) (fun k a b => ITMem_HI k a b) k i j
  have hk : (k : ℕ) < 6 := k.isLt
  have hi : (i : ℕ) < 9 := by have := i.isLt; omega
  have ha : (a : ℕ) < 9 := by have := a.isLt; omega
  exact ITMem_BI _ _ _ hk hi ha

/-! ### The tensor of `F` -/

/-- The interval tensor of `F = Fh (Hp pivotsNum)`. -/
def CFdata : IT := CF MIdata

/-- and the real tensor it encloses -/
noncomputable def cFdata : RT := cF (Mmat (Hp pivotsNum))

theorem ITMem_CFdata : ITMem CFdata cFdata := ITMem_CF (Mmat (Hp pivotsNum)) ITMem_MIdata

theorem ev_cFdata (u v t : ℝ) : ev cFdata u v t = Fh (Hp pivotsNum) u v t :=
  ev_cF_eq_Fh pivotsNum u v t


/-! ### The pivot uncertainty

The true pivots are known only to `pivotEps`.  Rather than carry an `ℓ¹` bound through the
argument, the uncertainty is folded into the data: an entry of `Hp p` differs from the same entry
of `Hp pivotsNum` by at most `ε` times the number of pivot slots sitting at that position
(`abs_Hp_sub_apply_le`), which is `0` or `1`.  Widening those entries by that much makes the whole
tensor enclose `F` for the *true* certificate. -/

/-- The pivot enclosure assumed: `10⁻¹²`, on the grid. -/
def EPS : ℤ := 10000000000000000000000000000

/-- How many pivot slots sit at position `(k,a,b)`. -/
def slotCnt (k a b : ℕ) : ℕ :=
  (Finset.univ.filter (fun j : Fin 24 => slotN (j : ℕ) = (k, a, b) ∨ slotN (j : ℕ) = (k, b, a))).card

theorem sum_eH_eq (k a b : ℕ) : ∑ j : Fin 24, eH j k a b = (slotCnt k a b : ℝ) := by
  simp only [eH, slotCnt, slotN_eq]
  exact Finset.sum_boole _ _

/-- `Hp p` for any `p` within `EPS/SCALE` of `pivotsNum`. -/
def HIe (k a b : ℕ) : Itv :=
  ⟨(HI k a b).lo - slotCnt k a b * EPS, (HI k a b).hi + slotCnt k a b * EPS⟩

theorem ITMem_HIe {p : Fin 24 → ℝ} (hclose : ∀ j, |p j - pivotsNum j| ≤ (EPS : ℝ) / SCALE)
    (k : Fin 6) (a b : Fin (9 - (k : ℕ))) :
    (HIe (k : ℕ) (a : ℕ) (b : ℕ)).Mem (Hp p k a b) := by
  have hS := SCALE_pos'
  obtain ⟨h1, h2⟩ := ITMem_HI k a b
  have hdiff := abs_Hp_sub_apply_le hclose k a b
  rw [sum_eH_eq] at hdiff
  obtain ⟨d1, d2⟩ := abs_le.mp hdiff
  set N : ℝ := (slotCnt (k : ℕ) (a : ℕ) (b : ℕ) : ℝ) with hN
  have hcast : (-((EPS : ℝ) / SCALE * N)) * SCALE = -((EPS : ℝ) * N) := by
    field_simp
  have hcast' : ((EPS : ℝ) / SCALE * N) * SCALE = (EPS : ℝ) * N := by field_simp
  have hlow : -((EPS : ℝ) * N) ≤ (Hp p k a b - Hp pivotsNum k a b) * SCALE := by
    rw [← hcast]; exact mul_le_mul_of_nonneg_right d1 hS.le
  have hhigh : (Hp p k a b - Hp pivotsNum k a b) * SCALE ≤ (EPS : ℝ) * N := by
    rw [← hcast']; exact mul_le_mul_of_nonneg_right d2 hS.le
  constructor <;> simp only [HIe] <;> push_cast <;> nlinarith

/-- The constant matrices for the true certificate. -/
def MIedata : (k : Fin 6) → Fin (9 - (k : ℕ)) → Fin (9 - (k : ℕ)) → Itv := MI BI HIe

theorem ITMem_MIedata {p : Fin 24 → ℝ} (hclose : ∀ j, |p j - pivotsNum j| ≤ (EPS : ℝ) / SCALE)
    (k : Fin 6) (i j : Fin (9 - (k : ℕ))) :
    (MIedata k i j).Mem (Mmat (Hp p) k i j) := by
  refine ITMem_MI (fun k i a => ?_) (fun k a b => ITMem_HIe hclose k a b) k i j
  have hk : (k : ℕ) < 6 := k.isLt
  have hi : (i : ℕ) < 9 := by have := i.isLt; omega
  have ha : (a : ℕ) < 9 := by have := a.isLt; omega
  exact ITMem_BI _ _ _ hk hi ha

/-- The interval tensor of `F` for the *true* certificate. -/
def CFedata : IT := CF MIedata

theorem ITMem_CFedata {p : Fin 24 → ℝ} (hclose : ∀ j, |p j - pivotsNum j| ≤ (EPS : ℝ) / SCALE) :
    ITMem CFedata (cF (Mmat (Hp p))) :=
  ITMem_CF (Mmat (Hp p)) (ITMem_MIedata hclose)

end Thomson.Tri5b
