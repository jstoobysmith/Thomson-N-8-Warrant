import Thomson.TriangleGlobal.Bridge
import Thomson.Antiprism.UStarSharp

/-! # Task 5b, step 15: the certificate's constants as intervals — GENERATED

The `B` entries are polynomials in `u*` (`Bpoly`); the `H` entries are rationals.  Both are
read into fixed-point intervals here, with one lemma per table entry.  The `u*` enclosure is the
32-digit one of `Thomson.Antiprism.UStarSharp`, and every rational in the tables has a denominator dividing
`10⁴⁰`, so nothing is lost in the conversion.

`simp`/`unfold` on `Bpoly` and `HfixTable` is pathological (61 and 92 arms over three `ℕ`
arguments; `whnf` blows up), but `rfl` on a *concrete* index triple is instant — hence the
`show <the arm's right-hand side> = _` idiom throughout. -/

namespace Thomson.Tri5b

open Thomson

/-- Horner value of a fixed-point coefficient list. -/
noncomputable def polyR (cs : List ℤ) (x : ℝ) : ℝ :=
  cs.foldr (fun c acc => (c : ℝ) / SCALE + x * acc) 0

/-- `u*` on the fixed-point grid (32 digits, from `uStar_mem_Icc_sharper`). -/
def uStarI : Itv := ⟨3140893678892018673812332619607600000000, 3140893678892018673812332619607900000000⟩

theorem mem_uStarI : uStarI.Mem uStar := by
  obtain ⟨h1, h2⟩ := uStar_mem_Icc_sharper
  constructor <;> · simp only [uStarI, SCALE, Itv.Mem]
                    push_cast
                    linarith

